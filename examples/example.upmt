  "interviews": [
    {
      "id": "e8ee6382-22e8-45a8-9b00-462f2e6f33f4",
      "creator": "Nicolas",
      "contributor": "Nicolas",
      "projectId": "Basic_Example",
      "created": "2026-01-08T13:58:41.571Z",
      "modified": "2026-01-08T13:58:41.571Z",
      "name": "Interview 1",
      "color": "",
      "note": "This is a mockup interview content to illustrate micro-phenological modeling, taken from Petitmengin, Claire, Anne Remillieux, et Camila Valenzuela-Moguillansky. « Discovering the Structures of Lived Experience ». Phenomenology and the Cognitive Sciences 18, nᵒ 4 (2019): 691‑730. https://doi.org/10.1007/s11097-018-9597-4",
      "date": "2018-06-12",
      "text": "\nIt was in Puiseaux one April morning, last spring. I just hung up the phone after a conversation with Tom. \nI feel sad. \nMy heart is tight, like a frozen ball in the middle of my chest.\nAt onepoint, the song of a turtle-dove comes through the open window. \nAnd suddenly, this ball begins to melt, to dilute, a new heat invades my whole body. ",
      "participantName": "John",
      "isActive": true,
      "parentId": "Basic_Example",
      "annotations": [
        {
          "id": "hkIO1_7gBIMW3eZ-POOkI",
          "creator": "YP",
          "contributor": "YP",
          "projectId": "Basic_Example",
          "created": "2026-01-08T16:43:37.345Z",
          "modified": "2026-01-08T16:43:37.345Z",
